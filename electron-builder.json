{
  "appId": "com.valeverde.dashboard",
  "productName": "Vale Verde Dashboard",
  "directories": {
    "output": "dist"
  },
  "files": [
    "**/*",
    "!node_modules/**",
    "!dist/**",
    "!\.git/**"
  ],
  "win": {
    "target": [
      {
        "target": "nsis",
        "arch": ["x64"]
      }
    ],
    "icon": "build/icon.ico"
  },
  "nsis": {
    "oneClick": true,
    "allowToChangeInstallationDirectory": false,
    "createDesktopShortcut": true,
    "createStartMenuShortcut": true
  }
}
