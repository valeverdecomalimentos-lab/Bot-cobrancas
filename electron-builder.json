{
  "appId": "com.valeverde.dashboard",
  "productName": "Vale Verde Dashboard - Void Hub",
  "directories": {
    "output": "dist"
  },
  "files": [
    "**/*",
    "!dist/**",
    "!.git/**",
    "!tests/**",
    "!playwright.config.*",
    "!.artifacts/**",
    "!playwright-report/**",
    "!teste.js",
    "!.env",
    "!ai-credentials.json",
    "!data/**",
    "!listas/**",
    "!**/*.fbconsumer",
    "!**/*.fdb",
    "!**/*.sqlite",
    "!**/*.sqlite-wal",
    "!**/*.sqlite-shm",
    "!reports/**",
    "!uploads/**",
    "!logs/**",
    "!.wwebjs_auth/**",
    "!.wwebjs_cache/**"
  ],
  "win": {
    "target": [
      {
        "target": "nsis",
        "arch": ["x64"]
      }
    ],
    "icon": "logo.ico"
  },
  "nsis": {
    "oneClick": true,
    "allowToChangeInstallationDirectory": false,
    "createDesktopShortcut": true,
    "createStartMenuShortcut": true
  }
}
