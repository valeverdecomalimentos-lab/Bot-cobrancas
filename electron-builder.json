{
  "appId": "com.valeverde.dashboard",
  "productName": "Vale Verde Dashboard - Void Hub",
  "directories": {
    "output": "dist"
  },
  "files": [
    "**/*",
    "!dist/**",
    "!.git/**",
    "!.env",
    "!data/**",
    "!reports/**",
    "!uploads/**",
    "!logs/**",
    "!.wwebjs_auth/**",
    "!.wwebjs_cache/**"
  ],
  "win": {
    "target": [
      {
        "target": "nsis",
        "arch": ["x64"]
      }
    ],
    "icon": "logo.ico"
  },
  "nsis": {
    "oneClick": true,
    "allowToChangeInstallationDirectory": false,
    "createDesktopShortcut": true,
    "createStartMenuShortcut": true
  }
}
